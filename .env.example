# Neon: pooled connection for web requests (the CLI fills this securely).
DATABASE_URL=postgresql://radar:radar@localhost:5432/radar
# Neon: direct connection for migrations and collector session locks.
# Optional for a local non-pooled PostgreSQL connection.
DATABASE_URL_UNPOOLED=
# Generate separate random secrets: openssl rand -hex 32
ADMIN_PASSWORD=
SESSION_SECRET=
CRON_SECRET=
VK_ACCESS_TOKEN=
VK_API_VERSION=5.199
# Explicit, permitted public community/user wall IDs, comma-separated; communities use negative IDs
VK_WALL_IDS=

# Required behind an HTTPS reverse proxy, e.g. https://radar.example.com
APP_ORIGIN=
